# =============================================================================
# Enterprise Knowledge Base - Local Development Environment Variables
# =============================================================================
#
# Usage:
#   1. Copy this file to .env:
#      cp .env.example .env
#
#   2. Fill in your own API keys, mail password, etc.:
#      vim .env
#
#   3. Load the environment variables before starting the services:
#      source .env
#      then start the services as usual
#
# =============================================================================

# =============================================================================
# Machine identifier (required)
# =============================================================================
# Each developer must set a unique COMPUTER_ID, used to isolate service
# instances registered in Nacos per machine. If unset, the system username
# (${USER}) is used as the default.
#
# Example:
#   COMPUTER_ID=alice
#   COMPUTER_ID=dev01
COMPUTER_ID=mac

# =============================================================================
# Infrastructure connection settings (all optional, default to localhost)
# =============================================================================
# By default every service connects to localhost for MySQL, Redis, Nacos,
# RabbitMQ, Elasticsearch, Neo4j and MongoDB. Override any of these if your
# infrastructure runs elsewhere.
# NACOS_SERVER_ADDR=127.0.0.1:8848
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=nacos
# MYSQL_PASSWORD=123456
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# MONGODB_HOST=localhost
# MONGODB_USERNAME=mongodb
# MONGODB_PASSWORD=
# RUSTFS_ENDPOINT=localhost
# RUSTFS_ACCESS_KEY=
# RUSTFS_SECRET_KEY=

# =============================================================================
# JWT signing secret (required)
# =============================================================================
# Must be identical across kb-user-auth and kb-foundation. Use a long random
# string in any real deployment.
JWT_SECRET=please-change-this-to-a-long-random-secret-in-production

# =============================================================================
# LLM configuration (optional - AI features are disabled if left unset)
# =============================================================================

# --- Qwen (default model) ---
# Get an API key: https://dashscope.console.aliyun.com/
# Free tier: new users get 2M tokens for qwen3-max
QWEN_API_KEY=your-qwen-api-key-here
# Model name (optional, defaults to qwen3-max)
# QWEN_MODEL=qwen3-max
# API base URL (optional, rarely needs changing)
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- DeepSeek (optional, secondary model) ---
# Get an API key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# --- Default AI model ---
# Options: qwen | deepseek (default qwen)
# AI_DEFAULT_MODEL=qwen

# =============================================================================
# RAG / vector retrieval configuration (optional, degrades gracefully if unset)
# =============================================================================
# RAG_ENABLED=true
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64

# =============================================================================
# Elasticsearch configuration (RAG/KAG vector store, optional)
# =============================================================================
# ELASTICSEARCH_URIS=http://localhost:9200

# =============================================================================
# Neo4j configuration (knowledge graph, optional)
# =============================================================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password

# =============================================================================
# Mail configuration (required - used for account activation and password reset)
# =============================================================================
#
# Example using a 163.com mailbox:
#   1. Log in to mail.163.com
#   2. Settings -> POP3/SMTP/IMAP -> enable SMTP
#   3. Generate an authorization code (not your login password!)
#   4. Put it in MAIL_PASSWORD below
#
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your-email@163.com
MAIL_PASSWORD=your-smtp-auth-code

# Gmail (alternative):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# --- Frontend URL (used in activation email links) ---
# APP_FRONTEND_URL=http://localhost:5173
