<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.base.statistics.mapper.CommentStatisticsMapper">

    <!-- Common query result mapping -->
    <resultMap id="BaseResultMap" type="com.knowledge.base.statistics.entity.CommentStatistics">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="document_id" property="documentId" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <!-- Common query result columns -->
    <sql id="Base_Column_List">
        id, user_id, document_id, created_at
    </sql>

    <!-- Count comments by user ID -->
    <select id="countByUserId" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM kb_comment
        WHERE user_id = #{userId}
    </select>

    <!-- Count comments by document ID -->
    <select id="countByDocumentId" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM kb_comment
        WHERE document_id = #{documentId}
    </select>

    <!-- Count comments within a specified date range -->
    <select id="countByDateRange" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM kb_comment
        WHERE created_at &gt;= #{startDate}
        AND created_at &lt;= #{endDate}
    </select>

    <!-- Count daily comment totals -->
    <select id="countDailyComments" resultType="com.knowledge.base.statistics.model.DailyCount">
        SELECT DATE(created_at) AS date, COUNT(*) AS count
        FROM kb_comment
        WHERE created_at &gt;= #{startDate}
        AND created_at &lt;= #{endDate}
        GROUP BY DATE(created_at)
        ORDER BY date ASC
    </select>

    <!-- Count a user's comments within a specified date range -->
    <select id="countByUserIdAndDateRange" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM kb_comment
        WHERE user_id = #{userId}
        AND created_at &gt;= #{startDate}
        AND created_at &lt;= #{endDate}
    </select>

    <!-- Find the most active commenting users -->
    <select id="selectTopCommenters" resultType="com.knowledge.base.statistics.model.IdCount">
        SELECT user_id AS id, COUNT(*) AS count
        FROM kb_comment
        GROUP BY user_id
        ORDER BY count DESC
        LIMIT #{limit}
    </select>

    <!-- Find the most commented documents -->
    <select id="selectMostCommentedDocuments" resultType="com.knowledge.base.statistics.model.IdCount">
        SELECT document_id AS id, COUNT(*) AS count
        FROM kb_comment
        GROUP BY document_id
        ORDER BY count DESC
        LIMIT #{limit}
    </select>

    <!-- Compute the average daily comment count -->
    <select id="getAverageDailyComments" resultType="java.lang.Double">
        SELECT COUNT(*) / DATEDIFF(#{endDate}, #{startDate})
        FROM kb_comment
        WHERE created_at &gt;= #{startDate}
        AND created_at &lt;= #{endDate}
    </select>

</mapper>
