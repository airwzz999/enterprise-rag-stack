<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.base.file.mapper.FileMapper">

    <!-- Common query result mapping -->
    <resultMap id="BaseResultMap" type="com.knowledge.base.file.entity.FileInfo">
        <id column="id" property="id" />
        <result column="original_name" property="originalName" />
        <result column="stored_name" property="storedName" />
        <result column="file_path" property="filePath" />
        <result column="file_size" property="fileSize" />
        <result column="file_type" property="fileType" />
        <result column="mime_type" property="mimeType" />
        <result column="file_hash" property="fileHash" />
        <result column="storage_type" property="storageType" />
        <result column="bucket_name" property="bucketName" />
        <result column="uploader_id" property="uploaderId" />
        <result column="access_level" property="accessLevel" />
        <result column="download_count" property="downloadCount" />
        <result column="status" property="status" />
        <result column="deleted" property="deleted" />
        <result column="version" property="version" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
    </resultMap>

    <!-- Common query result columns -->
    <sql id="Base_Column_List">
        id, original_name, stored_name, file_path, file_size, file_type, mime_type, file_hash,
        storage_type, bucket_name, uploader_id, access_level, download_count, status,
        deleted, version, created_at, updated_at, create_by, update_by
    </sql>

    <!-- Query file list by uploader ID -->
    <select id="selectByUploaderId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM tb_file
        WHERE uploader_id = #{uploaderId}
        AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- Query file list by file type -->
    <select id="selectByFileType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM tb_file
        WHERE file_type = #{fileType}
        AND status = 1
        AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- Query file by file hash -->
    <select id="selectByFileHash" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM tb_file
        WHERE file_hash = #{fileHash}
        AND deleted = 0
        LIMIT 1
    </select>

    <!-- Query file list by storage type -->
    <select id="selectByStorageType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM tb_file
        WHERE storage_type = #{storageType}
        AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- Query file list by access level -->
    <select id="selectByAccessLevel" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM tb_file
        WHERE access_level &lt;= #{accessLevel}
        AND status = 1
        AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- Increment download count -->
    <update id="incrementDownloadCount">
        UPDATE tb_file
        SET download_count = download_count + 1
        WHERE id = #{fileId}
        AND deleted = 0
    </update>

    <!-- Update file status -->
    <update id="updateStatus">
        UPDATE tb_file
        SET status = #{status}
        WHERE id = #{fileId}
        AND deleted = 0
    </update>

    <!-- Check whether file hash exists -->
    <select id="checkFileHashExists" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0
        FROM tb_file
        WHERE file_hash = #{fileHash}
        AND deleted = 0
    </select>

    <!-- Count the number of files uploaded by user -->
    <select id="countByUploaderId" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM tb_file
        WHERE uploader_id = #{uploaderId}
        AND deleted = 0
    </select>

    <!-- Sum the total size of files uploaded by user -->
    <select id="sumFileSizeByUploaderId" resultType="java.lang.Long">
        SELECT COALESCE(SUM(file_size), 0)
        FROM tb_file
        WHERE uploader_id = #{uploaderId}
        AND status = 1
        AND deleted = 0
    </select>

    <!-- Query file list by bucket name -->
    <select id="selectByBucketName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM tb_file
        WHERE bucket_name = #{bucketName}
        AND deleted = 0
        ORDER BY created_at DESC
    </select>

</mapper>
