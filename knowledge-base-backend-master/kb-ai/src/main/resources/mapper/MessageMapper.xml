<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.base.ai.mapper.MessageMapper">

    <!-- Generic query result mapping -->
    <resultMap id="BaseResultMap" type="com.knowledge.base.ai.entity.Message">
        <id column="id" property="id" />
        <result column="conversation_id" property="conversationId" />
        <result column="role" property="role" />
        <result column="content" property="content" />
        <result column="tokens" property="tokens" />
        <result column="created_at" property="createdAt" />
        <result column="deleted" property="deleted" />
    </resultMap>

    <!-- Generic query result columns -->
    <sql id="Base_Column_List">
        id, conversation_id, role, content, tokens, created_at, deleted
    </sql>

    <!-- Query the message list by conversation ID -->
    <select id="selectByConversationId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM message
        WHERE conversation_id = #{conversationId}
        AND deleted = 0
        ORDER BY created_at ASC
    </select>

    <!-- Query the message list by conversation ID and role -->
    <select id="selectByConversationIdAndRole" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM message
        WHERE conversation_id = #{conversationId}
        AND role = #{role}
        AND deleted = 0
        ORDER BY created_at ASC
    </select>

    <!-- Count the number of messages in a conversation -->
    <select id="countByConversationId" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM message
        WHERE conversation_id = #{conversationId}
        AND deleted = 0
    </select>

    <!-- Sum the total token count for a conversation -->
    <select id="sumTokensByConversationId" resultType="java.lang.Integer">
        SELECT COALESCE(SUM(tokens), 0)
        FROM message
        WHERE conversation_id = #{conversationId}
        AND deleted = 0
    </select>

    <!-- Query the last message in a conversation -->
    <select id="selectLastMessageByConversationId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM message
        WHERE conversation_id = #{conversationId}
        AND deleted = 0
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <!-- Batch-insert messages -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO message (conversation_id, role, content, tokens, created_at, deleted)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.conversationId}, #{item.role}, #{item.content}, #{item.tokens}, #{item.createdAt}, 0)
        </foreach>
    </insert>

</mapper>
