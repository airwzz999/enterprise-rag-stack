<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.base.ai.mapper.ConversationMapper">

    <!-- Generic query result mapping -->
    <resultMap id="BaseResultMap" type="com.knowledge.base.ai.entity.Conversation">
        <id column="id" property="id" />
        <result column="title" property="title" />
        <result column="user_id" property="userId" />
        <result column="model" property="model" />
        <result column="system_prompt" property="systemPrompt" />
        <result column="tokens_used" property="tokensUsed" />
        <result column="message_count" property="messageCount" />
        <result column="status" property="status" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="deleted" property="deleted" />
    </resultMap>

    <!-- Generic query result columns -->
    <sql id="Base_Column_List">
        id, title, user_id, model, system_prompt, tokens_used, message_count, status, created_at, updated_at, deleted
    </sql>

    <!-- Query the conversation list by user ID -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM conversation
        WHERE user_id = #{userId}
        AND deleted = 0
        ORDER BY updated_at DESC
    </select>

    <!-- Query the conversation list by user ID and status -->
    <select id="selectByUserIdAndStatus" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM conversation
        WHERE user_id = #{userId}
        AND status = #{status}
        AND deleted = 0
        ORDER BY updated_at DESC
    </select>

    <!-- Query the conversation list by model -->
    <select id="selectByModel" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM conversation
        WHERE model = #{model}
        AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- Update the conversation's token usage -->
    <update id="updateTokensUsed">
        UPDATE conversation
        SET tokens_used = tokens_used + #{tokens},
            updated_at = NOW()
        WHERE id = #{conversationId}
        AND deleted = 0
    </update>

    <!-- Increment the message count -->
    <update id="incrementMessageCount">
        UPDATE conversation
        SET message_count = message_count + 1,
            updated_at = NOW()
        WHERE id = #{conversationId}
        AND deleted = 0
    </update>

    <!-- Update conversation status -->
    <update id="updateStatus">
        UPDATE conversation
        SET status = #{status},
            updated_at = NOW()
        WHERE id = #{conversationId}
        AND deleted = 0
    </update>

    <!-- Count the number of conversations for a user -->
    <select id="countByUserId" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM conversation
        WHERE user_id = #{userId}
        AND deleted = 0
    </select>

    <!-- Sum the total token usage for a user -->
    <select id="sumTokensByUserId" resultType="java.lang.Long">
        SELECT COALESCE(SUM(tokens_used), 0)
        FROM conversation
        WHERE user_id = #{userId}
        AND deleted = 0
    </select>

</mapper>
