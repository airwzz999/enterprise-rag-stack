# API configuration - proxied through Vite to avoid CORS issues
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws

# App configuration
VITE_APP_NAME=Enterprise Knowledge Base
VITE_APP_DESCRIPTION=Intelligent Enterprise Knowledge Management Platform
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
VITE_APP_DEBUG=true
VITE_APP_PERFORMANCE=false
VITE_APP_ERROR_REPORT=false

# File upload configuration
VITE_UPLOAD_MAX_SIZE=10485760
VITE_UPLOAD_ALLOWED_TYPES=.doc,.docx,.pdf,.txt,.md,.jpg,.jpeg,.png,.gif

# Cache configuration
VITE_CACHE_ENABLED=true

# Request configuration
VITE_REQUEST_TIMEOUT=30000
VITE_REQUEST_RETRY=3
VITE_REQUEST_RETRY_DELAY=1000
VITE_REQUEST_CACHE=false
VITE_REQUEST_LOG=true

# Pagination configuration
VITE_PAGE_SIZE=12

# Editor configuration
VITE_EDITOR_AUTO_SAVE=10000
VITE_EDITOR_AUTO_SAVE=true

# AI configuration
VITE_AI_API_URL=/api/ai
VITE_AI_MODEL=claude-3-5-sonnet-20241022
VITE_AI_MAX_TOKENS=4096
VITE_AI_TEMPERATURE=0.7
VITE_AI_STREAM=true
VITE_AI_TIMEOUT=60000

# WebSocket configuration
VITE_WS_ENABLED=true
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT=5
VITE_WS_HEARTBEAT=30000

# Performance monitoring configuration
VITE_PERFORMANCE_SAMPLE_RATE=0.1
VITE_PERFORMANCE_REPORT_URL=/api/performance/report
VITE_PERFORMANCE_BATCH_SIZE=10

# Error reporting configuration
VITE_ERROR_REPORT_URL=/api/error/report
VITE_ERROR_REPORT_CONSOLE=true
VITE_ERROR_REPORT_REJECTION=true
VITE_ERROR_REPORT_RESOURCE=true

# Third-party service configuration
VITE_BAIDU_ANALYTICS_ID=
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
